# ── Le Ministère — configuration ───────────────────────────────────────
# Copie ce fichier en .env sur le VPS. Ne commite JAMAIS le .env.

# Claude (rédaction + stratégie)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Repli serveur si Claude refuse une requête (1 = activé, recommandé)
CLAUDE_FALLBACKS=1

# Dashboard
PORT=3000
DASHBOARD_USER=ministre
DASHBOARD_PASSWORD=change-moi
# URL publique du VPS (sert à construire les liens courts trackés /go/xxx)
PUBLIC_URL=https://exemple.fr

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Salon où le bot crée les invitations par plateforme (ex : #bienvenue)
DISCORD_INVITE_CHANNEL_ID=
# Salon d'annonces où le Ministère publie
DISCORD_ANNOUNCE_CHANNEL_ID=
# Invitation de secours si le bot n'est pas configuré
DISCORD_FALLBACK_INVITE=https://discord.gg/xxxxxxx

# Rendu
# Chemin de Chromium (apt install chromium → /usr/bin/chromium)
CHROMIUM_PATH=/usr/bin/chromium

# Voix off : la voix du Gouverneur, c'est toi. Tu l'enregistres depuis le dashboard
# (bouton « Enregistrer » ou import d'un fichier) : elle est toujours prioritaire.
# Synthèse vocale de secours, facultative : none | elevenlabs | piper
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PIPER_BIN=piper
PIPER_MODEL=/opt/piper/fr_FR-tom-medium.onnx

# Planification automatique (cron, heure de Bruxelles)
SCHEDULER_ENABLED=1
DAILY_GENERATION_CRON=0 6 * * *
POSTS_PER_DAY=3
